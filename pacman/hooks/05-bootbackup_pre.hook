# Runs after 00-timeshift-autosnap and before 60-mkinitcpio-remove (which deletes kernels from /boot).
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Operation = Remove
Target = boot/*
Target = usr/lib/modules/*/vmlinuz
Target = usr/lib/initcpio/*
Target = usr/lib/firmware/*
Target = usr/lib/modules/*/extramodules/
Target = usr/src/*/dkms.conf
Target = usr/lib/systemd/systemd
Target = usr/lib/systemd/systemd-udevd
Target = usr/bin/cryptsetup
Target = usr/lib/libcryptsetup.so
Target = usr/lib/modprobe.d/

[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = mkinitcpio
Target = nvidia
Target = nvidia-lts
Target = nvidia-open

[Action]
Depends = rsync
Description = Backing up pre /boot...
When = PreTransaction
Exec = /usr/bin/bash -c 'now=$(date +%Y_%m_%d_%H.%M.%S); rsync -a --mkpath --delete /boot/ "/.bootbackup/${now}_pre"/ && touch "/.bootbackup/${now}_pre"'
