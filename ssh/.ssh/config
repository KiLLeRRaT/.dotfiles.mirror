# Agent selection — must stay at the END of this file. See ~/.ssh/rc.
# FROM: https://developer.1password.com/docs/ssh/agent/forwarding/
# - SSH'd in with a forwarded agent: use it (prompts appear on the machine you're sitting at).
# - Otherwise: the local 1Password agent.
# `test -S` is false for a dangling symlink, so this falls back automatically after logout.
Match host * exec "test -S ~/.ssh/agent-forwarded.sock"
	IdentityAgent ~/.ssh/agent-forwarded.sock

Match host * exec "sh -c '! test -S ~/.ssh/agent-forwarded.sock && test -S ~/.1password/agent.sock'"
	IdentityAgent ~/.1password/agent.sock
