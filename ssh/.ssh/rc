# ~/.ssh/rc — run by sshd (via /bin/sh) on every SSH login, before the shell. See sshd(8) SSHRC.
#
# 1. X11: because this file exists, sshd no longer runs xauth itself, so do it here
#    (standard snippet from sshd(8); X11Forwarding is enabled on this host).
if read proto cookie && [ -n "$DISPLAY" ]; then
	if [ "$(echo "$DISPLAY" | cut -c1-10)" = 'localhost:' ]; then
		echo add "unix:$(echo "$DISPLAY" | cut -c11-)" "$proto" "$cookie"
	else
		echo add "$DISPLAY" "$proto" "$cookie"
	fi | xauth -q -
fi

# 2. Agent forwarding: when this login forwarded an agent (ssh -A / ForwardAgent yes), point a
#    stable path at it. ~/.ssh/config and ~/.gitscripts/git-ssh-sign use that path, so every
#    shell (including old tmux panes) uses the forwarded agent while the session is alive.
#    After logout the symlink dangles, `test -S` fails, and they fall back to 1Password.
if [ -S "$SSH_AUTH_SOCK" ]; then
	ln -sfn "$SSH_AUTH_SOCK" "$HOME/.ssh/agent-forwarded.sock"
fi
